{
  "name": "korviana-pmp",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "npm run css:build && npm run dashboard:build && nest build",
    "css:build": "tailwindcss -i ./src/styles.css -o ./public/css/tailwind.css --minify",
    "dashboard:build": "esbuild src/admin-dashboard/main.tsx --bundle --minify --format=iife --target=es2020 --outfile=public/js/admin-dashboard.js",
    "test": "npm run build && node --test test/pricing.test.cjs",
    "start": "node dist/main.js",
    "start:dev": "npm run css:build && npm run dashboard:build && nest start --watch",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.13",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
