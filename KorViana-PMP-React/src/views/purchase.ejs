<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Purchase request · KorViana</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-bone font-sans text-ink">
  <%- include('partials/header') %>
  <main class="page-width py-10 sm:py-16">
    <section class="max-w-3xl">
      <p class="text-xs font-bold tracking-[.2em] text-gold-deep">PURCHASE</p>
      <h1 class="mt-3 font-display text-4xl sm:text-5xl">Build a purchase request.</h1>
      <p class="mt-4 text-base leading-7 text-muted">Create a request using the current reference rates and denomination markups. Submitting opens an email draft; this page does not place an order or collect payment.</p>
    </section>

    <section class="surface mt-7 p-5 sm:p-7" aria-label="Published base rates">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold tracking-[.16em] text-gold-deep">BASE RATES</p>
          <h2 class="mt-2 font-display text-2xl">Current reference rates</h2>
        </div>
        <p class="text-xs text-muted"><%= pricing.updatedAt ? `Updated ${new Date(pricing.updatedAt).toLocaleString('en-IN')}` : 'Starter rates · verify before use' %></p>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <p class="rounded-lg bg-bone p-4 text-sm leading-6"><strong>Gold 999:</strong> ₹<%= Number(pricing.rates.gold).toLocaleString('en-IN') %> per 10 grams</p>
        <p class="rounded-lg bg-bone p-4 text-sm leading-6"><strong>Silver 999:</strong> ₹<%= Number(pricing.rates.silver).toLocaleString('en-IN') %> per kilogram</p>
      </div>
      <p class="mt-4 text-xs leading-5 text-muted">KorViana prices include the listed denomination markup. Rates are managed by an administrator; verify final pricing and tax treatment before confirming a purchase.</p>
    </section>

    <section id="request-app" class="surface mt-5 p-5 sm:p-7" data-products="<%= JSON.stringify(products.map((product) => ({ sku: product.sku, metal: product.metal, weight: Number(product.weightGrams), price: Number(product.price) }))) %>">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-bold tracking-[.16em] text-gold-deep">YOUR REQUEST</p>
          <h2 class="mt-2 font-display text-2xl">Add items</h2>
        </div>
        <span class="w-fit rounded-full border border-gold/40 bg-[#f7f1e4] px-3 py-1 text-xs font-semibold text-gold-deep">Purchase request only</span>
      </div>
      <form id="request-form" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_1.5fr_.8fr_auto] lg:items-end">
        <label class="text-sm font-semibold" for="item-metal">Item
          <select class="field mt-2" id="item-metal">
            <option value="gold">Gold</option>
            <option value="silver">Silver</option>
          </select>
        </label>
        <label class="text-sm font-semibold" for="item-weight">Denomination / Weight
          <select class="field mt-2" id="item-weight" required></select>
        </label>
        <label class="text-sm font-semibold" for="item-quantity">Quantity
          <input class="field mt-2" id="item-quantity" type="number" min="1" max="99" step="1" value="1" inputmode="numeric" required>
        </label>
        <button class="btn-primary w-full sm:col-span-2 lg:col-span-1" type="submit">Add item</button>
      </form>
      <p id="request-error" class="mt-3 text-sm text-red-700" role="alert" hidden></p>

      <div class="mt-8">
        <div class="flex items-center justify-between gap-3">
          <h3 class="font-display text-xl">Purchase list</h3>
          <span id="request-count" class="text-xs text-muted">0 items</span>
        </div>
        <div class="table-wrap mt-4 rounded-xl border border-hair bg-white">
          <table class="w-full border-collapse text-left text-sm">
            <thead class="bg-bone text-xs text-muted">
              <tr><th class="p-3">No.</th><th class="p-3">Item</th><th class="p-3">Quantity</th><th class="p-3">Price</th><th class="p-3">Action</th></tr>
            </thead>
            <tbody id="request-items">
              <tr><td class="p-4 text-muted" colspan="5">No items added yet.</td></tr>
            </tbody>
          </table>
        </div>
        <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-muted">Submitting creates an email draft only. It is not an online order or payment.</p>
          <button id="submit-request" class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto" type="button" disabled>Email purchase request</button>
        </div>
        <p id="request-status" class="mt-3 text-sm text-forest" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/purchase-request.js" defer></script>
</body>
</html>
